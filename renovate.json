{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":dependencyDashboard", ":semanticCommits", "group:recommended"],
  "labels": ["dependencies"],
  "schedule": ["at any time"],
  "rangeStrategy": "bump",
  "prConcurrentLimit": 10,
  "postUpdateOptions": ["npmInstallTwice"],
  "automergeType": "pr",
  "platformAutomerge": true,
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Auto-merge low-risk dependency updates after they have aged for a week and CI is green.",
      "matchUpdateTypes": ["minor", "patch", "lockFileMaintenance"],
      "minimumReleaseAge": "7 days",
      "automerge": true
    },
    {
      "description": "Do not modify Vue or Vite peer dependency ranges (library compatibility).",
      "matchDepTypes": ["peerDependencies"],
      "matchPackageNames": ["vue", "@vue/compiler-sfc", "vite"],
      "enabled": false
    },
    {
      "description": "Do not raise the engines.node range; it is the minimum consumers need, set by @earendil-works/pi-ai.",
      "matchDepTypes": ["engines"],
      "enabled": false
    }
  ]
}
